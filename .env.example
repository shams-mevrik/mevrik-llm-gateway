# Service
SERVICE_NAME=LLM Gateway
SERVICE_VERSION=1.0.0
SERVICE_DESCRIPTION=OpenAI-compatible gateway for vLLM backends

# Auth
API_KEY=sk-your-secret-key-change-me
# Optional: separate key for model add/update/delete, load tests, stats reset,
# /health/backends and backend details. Empty = API_KEY can do everything.
ADMIN_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info

# Root path (set if behind nginx with a subpath, e.g. /api)
ROOT_PATH=

# CORS (comma-separated, * for all)
ALLOWED_ORIGINS=*

# Proxy tuning
REQUEST_TIMEOUT=300
MAX_CONNECTIONS=500
# Per-backend probe timeout for GET /health/backends (seconds)
HEALTH_TIMEOUT=5

# Data paths (auto-created on startup)
DATA_DIR=data
MODELS_PATH=data/models.json
STATS_PATH=data/stats.json